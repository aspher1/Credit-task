# CreditAsk local config
# Copy to .env.local and edit. Never put live Stripe keys here.

APP_URL=http://localhost:3000

# Auth.js — admin approve path (credentials stub)
AUTH_SECRET=replace-with-a-long-random-string
AUTH_TRUST_HOST=true
ADMIN_EMAIL=admin@creditask.local
ADMIN_PASSWORD=changeme

# --- Stripe TEST MODE ONLY (live charges are rejected in code) ---
# Cursor Stripe connector, if present, is test mode only — do not enable live.
# Priority: Checkout Session (STRIPE_SECRET_KEY=sk_test_...) → Payment Link → stub.
# Dashboard (Test mode) → Developers → API keys → sk_test_...
# STRIPE_SECRET_KEY=sk_test_...
STRIPE_SECRET_KEY=

# Optional test publishable key (pk_test_ only; pk_live_ is rejected)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional catalog price for Checkout Sessions when sk_test_ is set.
# Same $79 one-time price as the Payment Link (test mode).
# Must be from the SAME test account as STRIPE_SECRET_KEY; otherwise leave empty.
# STRIPE_PRICE_ID=price_1UG2VzLRfzVmxUBhrC0lBeZy
STRIPE_PRICE_ID=price_1UG2VzLRfzVmxUBhrC0lBeZy

# Fallback if no secret key: TEST Payment Link (live buy.stripe.com links are rejected).
# Product: prod_VGZfwuTY9wNDi7
# Price:   price_1UG2VzLRfzVmxUBhrC0lBeZy  ($79 USD one-time)
# Link id: plink_1UG2W3LRfzVmxUBhldUMkNq5
# After payment redirect (already set on this link):
#   http://localhost:3000/pay/success?session_id={CHECKOUT_SESSION_ID}
# If STRIPE_SECRET_KEY is set, Checkout Sessions win; this URL is unused then.
STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/test_7sYfZigF9cyO6iseuO6kg00

# Optional. Dashboard (Test mode) → Developers → Webhooks → Add endpoint
# URL: ${APP_URL}/api/stripe/webhook  Events: checkout.session.completed
STRIPE_WEBHOOK_SECRET=

# Optional LLM. If unset, high-quality stub triage + letter is used.
XAI_API_KEY=
XAI_MODEL=grok-2-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Demo helpers (/api/demo/*, stub checkout). Set false to hide them.
ALLOW_DEMO=true
