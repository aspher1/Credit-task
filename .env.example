# CreditAsk local config
# Copy to .env.local and edit. Never put live Stripe keys here.

APP_URL=http://localhost:3000

# Auth.js — admin approve path (credentials stub)
AUTH_SECRET=replace-with-a-long-random-string
AUTH_TRUST_HOST=true
ADMIN_EMAIL=admin@creditask.local
ADMIN_PASSWORD=changeme

# Stripe TEST MODE ONLY. Live keys (sk_live_ / pk_live_) are rejected.
# Leave empty to use stub checkout (ALLOW_DEMO=true).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_LINK_URL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional LLM. If unset, high-quality stub triage + letter is used.
XAI_API_KEY=
XAI_MODEL=grok-2-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Demo helpers (/api/demo/*, stub checkout). Set false to hide them.
ALLOW_DEMO=true
